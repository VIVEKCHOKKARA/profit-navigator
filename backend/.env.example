# Profit Navigator backend — environment variables.
# Copy this file to ../.env (project root) and fill in the values.

# Flask port (defaults to 5000 if unset)
PORT=5000

# Groq API key — powers the AI Advisor chatbot.
# Get a FREE key at https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Optional: chat model override (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: secret used to sign auth tokens (a dev fallback is used if unset)
# AUTH_SECRET=change-me-in-production
